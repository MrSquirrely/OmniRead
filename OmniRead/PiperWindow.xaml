<hc:Window x:Class="OmniRead.PiperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:OmniRead.Localization"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        NonClientAreaBackground="{DynamicResource TitleBarBrush}" NonClientAreaForeground="{DynamicResource TextBrush}"
        Title="{l:Loc Piper_Title}" Icon="Assets/OmniRead.ico"
        Width="680" Height="760" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{l:Loc Piper_Intro}" TextWrapping="Wrap" />

        <!-- The engine itself -->
        <Border Grid.Row="1" Margin="0,14,0,0" Padding="14,12" CornerRadius="8" Background="{DynamicResource PageBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
            <DockPanel>
                <Button x:Name="UninstallButton" DockPanel.Dock="Right" Content="{l:Loc Piper_UninstallEngine}" VerticalAlignment="Center"
                        Margin="12,0,0,0" Click="OnUninstallClick" />
                <Button x:Name="InstallButton" DockPanel.Dock="Right" Content="{l:Loc Piper_InstallEngine}" VerticalAlignment="Center"
                        Margin="12,0,0,0" Click="OnInstallClick" />
                <TextBlock x:Name="EngineText" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <ListBox x:Name="VoiceList" Grid.Row="2" Margin="0,14,0,0" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <!-- One section per language. -->
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Margin="4,16,4,6" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,4">
                        <Button DockPanel.Dock="Right" Content="{Binding Action}" MinWidth="96" VerticalAlignment="Center"
                                Margin="12,0,0,0" Click="OnVoiceActionClick" />
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="{l:Loc Piper_Close}" MinWidth="96" Margin="12,0,0,0" IsCancel="True"
                    Click="OnCloseClick" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
        </DockPanel>
    </Grid>
</hc:Window>