<Window x:Class="OmniRead.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:OmniRead.Services"
        xmlns:l="clr-namespace:OmniRead.Localization"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="OmniRead" Icon="Assets/OmniRead.ico"
        Width="1280" Height="860" MinWidth="560" MinHeight="420"
        Background="{DynamicResource ChromeBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        AllowDrop="True" UseLayoutRounding="True"
        DragOver="OnDragOver" Drop="OnDrop">
    <Window.Resources>
        <!-- Right-click menu of the reading area. Items tagged "selection" need selected text. -->
        <ContextMenu x:Key="ReaderMenu" Opened="OnReaderMenuOpened">
            <MenuItem Header="{l:Loc Menu_LookUp}" InputGestureText="Ctrl+K" Tag="selection" Click="OnMenuLookUpClick" />
            <MenuItem Header="{l:Loc Notes_Highlight}" InputGestureText="Ctrl+H" Tag="selection" Click="OnHighlightClick" />
            <MenuItem Header="{l:Loc Menu_Copy}" InputGestureText="Ctrl+C" Tag="selection" Click="OnMenuCopyClick" />
            <Separator />
            <MenuItem Header="{l:Loc Notes_AddBookmark}" InputGestureText="Ctrl+D" Click="OnAddBookmarkClick" />
            <MenuItem Header="{l:Loc Menu_ReadFromHere}" Click="OnMenuReadFromHereClick" />
        </ContextMenu>
        <l:FormatConverter x:Key="Format" />
        <Style x:Key="IconButton" TargetType="ButtonBase">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Back" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,22,0,10" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid x:Name="Toolbar" Margin="8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Content="&#xE8F1;" ToolTip="{l:Loc Tip_Library}" Click="OnLibraryClick" />
                <Button Style="{StaticResource IconButton}" Content="&#xE8E5;" ToolTip="{l:Loc Tip_Open}" Click="OnOpenClick" />
                <ToggleButton x:Name="TocToggle" Style="{StaticResource IconButton}" Content="&#xE8FD;"
                              ToolTip="{l:Loc Tip_Contents}" Click="OnPanelToggle" />
                <ToggleButton x:Name="NotesToggle" Style="{StaticResource IconButton}" Content="&#xE734;"
                              ToolTip="{l:Loc Tip_Notes}" Click="OnPanelToggle" />
                <ToggleButton x:Name="SearchToggle" Style="{StaticResource IconButton}" Content="&#xE721;"
                              ToolTip="{l:Loc Tip_Search}" Click="OnPanelToggle" />
            </StackPanel>
            <TextBlock x:Name="TitleText" Grid.Column="1" Margin="16,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <ToggleButton x:Name="ReadToggle" Style="{StaticResource IconButton}" Content="&#xE767;"
                              ToolTip="{l:Loc Tip_ReadAloud}" Click="OnReadAloudClick" />
                <ToggleButton Style="{StaticResource IconButton}" Content="&#xE7B3;" IsChecked="{Binding EyeComfort}"
                              ToolTip="{l:Loc Tip_EyeComfort}" />
                <ToggleButton x:Name="SettingsToggle" Style="{StaticResource IconButton}" Content="&#xE8D2;"
                              ToolTip="{l:Loc Tip_Settings}" Click="OnPanelToggle" />
                <Button Style="{StaticResource IconButton}" Content="&#xE740;" ToolTip="{l:Loc Tip_FullScreen}" Click="OnFullScreenClick" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Contents -->
            <Border x:Name="TocPanel" Width="290" Visibility="Collapsed" Margin="8,0,0,0" CornerRadius="8"
                    Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{l:Loc Contents_Title}" Style="{StaticResource SectionTitle}" Margin="16,14,16,8" />
                    <ListBox x:Name="TocList" Background="Transparent" BorderThickness="0" Margin="4,0,4,8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnTocSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" Margin="{Binding Indent}" FontWeight="{Binding Weight}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Bookmarks and highlights -->
            <Border x:Name="NotesPanel" Width="320" Visibility="Collapsed" Margin="8,0,0,0" CornerRadius="8"
                    Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{l:Loc Notes_Title}" Style="{StaticResource SectionTitle}" Margin="16,14,16,8" />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="14,0,14,8">
                        <Button Content="{l:Loc Notes_AddBookmark}" ToolTip="Ctrl+D" Click="OnAddBookmarkClick" />
                        <Button Content="{l:Loc Notes_Highlight}" ToolTip="Ctrl+H" Margin="8,0,0,0" Click="OnHighlightClick" />
                    </StackPanel>
                    <TextBlock x:Name="NotesEmpty" DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="16,0,16,8"
                               Text="{l:Loc Notes_Empty}" />
                    <ListBox x:Name="NotesList" Background="Transparent" BorderThickness="0" Margin="4,0,4,8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                             SelectionChanged="OnNoteSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                               Margin="0,3,10,0" VerticalAlignment="Top" Foreground="{DynamicResource AccentBrush}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Where}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                        <TextBox Text="{Binding Note, UpdateSourceTrigger=LostFocus}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                 AcceptsReturn="True" ToolTip="{l:Loc Notes_NoteTip}" LostFocus="OnNoteLostFocus" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11"
                                            Content="&#xE711;" VerticalAlignment="Top" ToolTip="{l:Loc Notes_Delete}"
                                            Click="OnDeleteNoteClick" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Search -->
            <Border x:Name="SearchPanel" Width="320" Visibility="Collapsed" Margin="8,0,0,0" CornerRadius="8"
                    Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{l:Loc Search_Title}" Style="{StaticResource SectionTitle}" Margin="16,14,16,8" />
                    <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="14,0,14,6" TextChanged="OnSearchTextChanged"
                             KeyDown="OnSearchKeyDown" />
                    <TextBlock x:Name="SearchStatus" DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="16,0,16,8"
                               Text="{l:Loc Search_Hint}" />
                    <ListBox x:Name="SearchList" Background="Transparent" BorderThickness="0" Margin="4,0,4,8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                             SelectionChanged="OnSearchSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Before, Mode=OneWay}" /><Run Text="{Binding Match, Mode=OneWay}" FontWeight="Bold"
                                             Foreground="{DynamicResource AccentBrush}" /><Run Text="{Binding After, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Where}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Page -->
            <Border Grid.Column="1" Margin="8,0" CornerRadius="8" Background="{DynamicResource PageBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" ClipToBounds="True">
                <Grid x:Name="ReaderHost">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- Library: shown while no book is open -->
                    <Grid x:Name="WelcomePanel" Grid.Row="1" Margin="40,28,40,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <Image DockPanel.Dock="Left" Source="Assets/OmniRead.png" Width="56" Height="56"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox Width="150" SelectedValuePath="Tag" SelectedValue="{Binding LibrarySort}"
                                          ToolTip="{l:Loc Library_SortTip}">
                                    <ComboBoxItem Content="{l:Loc Library_Sort_Recent}" Tag="{x:Static s:LibrarySort.LastRead}" />
                                    <ComboBoxItem Content="{l:Loc Library_Sort_Title}" Tag="{x:Static s:LibrarySort.Title}" />
                                    <ComboBoxItem Content="{l:Loc Library_Sort_Author}" Tag="{x:Static s:LibrarySort.Author}" />
                                </ComboBox>
                                <Button Content="{l:Loc Library_Folders}" Margin="8,0,0,0" Click="OnLibraryFoldersClick" />
                                <Button Content="{l:Loc Welcome_Open}" Style="{DynamicResource AccentButtonStyle}" Margin="8,0,0,0"
                                        Padding="14,6" Click="OnOpenClick" />
                            </StackPanel>
                            <StackPanel Margin="14,0" VerticalAlignment="Center">
                                <TextBlock Text="OmniRead" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock x:Name="LibraryStatus" Style="{StaticResource Hint}" Margin="0" TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" />
                            </StackPanel>
                        </DockPanel>
                        <ListBox x:Name="LibraryList" Grid.Row="1" Margin="-8,18,-8,0" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PreviewMouseLeftButtonUp="OnLibraryMouseUp" KeyDown="OnLibraryKeyDown">
                            <!-- One shelf per library folder, labelled with the folder's name. -->
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="8,14,8,2">
                                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ItemCount}" Margin="10,0,0,1" VerticalAlignment="Bottom"
                                                           Foreground="{DynamicResource MutedBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="150" Margin="2,6" ToolTip="{Binding Path}">
                                        <StackPanel.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{l:Loc Library_Menu_Open}" Click="OnLibraryMenuOpen" />
                                                <MenuItem Header="{l:Loc Library_Menu_ShowInFolder}" Click="OnLibraryMenuShowInFolder" />
                                                <MenuItem Header="{l:Loc Library_Menu_CopyPath}" Click="OnLibraryMenuCopyPath" />
                                                <Separator />
                                                <MenuItem Header="{l:Loc Library_Menu_Forget}" Click="OnLibraryMenuForget" />
                                            </ContextMenu>
                                        </StackPanel.ContextMenu>
                                        <Grid Height="216">
                                            <!-- Stands in for a cover when the book has none. -->
                                            <Border CornerRadius="4" Background="{DynamicResource HoverBrush}"
                                                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" TextAlignment="Center"
                                                           VerticalAlignment="Center" Margin="12" FontFamily="Georgia" FontSize="15"
                                                           MaxHeight="150" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Background="#B0000000"
                                                    CornerRadius="3" Margin="6" Padding="5,1">
                                                <TextBlock Text="{Binding Format}" Foreground="White" FontSize="10" />
                                            </Border>
                                        </Grid>
                                        <ProgressBar Height="3" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Margin="0,6,0,0"
                                                     Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <!-- The book itself. A web view is a window of its own: nothing drawn by WPF can sit on top of it,
                         so the break reminder has its own row and the page-turn strips live inside the page. -->
                    <wv2:WebView2 x:Name="Web" Grid.Row="1" Margin="3" Visibility="Collapsed" AllowExternalDrop="True" />

                    <TextBlock x:Name="LoadingText" Grid.Row="1" Text="{l:Loc Status_Opening}" Visibility="Collapsed" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />

                    <!-- Card for footnotes and dictionary definitions; opens at the pointer. -->
                    <Popup x:Name="InfoPopup" Placement="Mouse" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Margin="8" Padding="16,14" CornerRadius="8" MaxWidth="460" Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                TextElement.Foreground="{DynamicResource TextBrush}">
                            <StackPanel>
                                <TextBlock x:Name="InfoTitle" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                                    <TextBlock x:Name="InfoBody" TextWrapping="Wrap" LineHeight="21" />
                                </ScrollViewer>
                                <TextBlock x:Name="InfoFooter" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                                <Button x:Name="InfoAction" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnInfoActionClick" />
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- 20-20-20 break reminder -->
                    <Border x:Name="BreakBanner" Visibility="Collapsed" HorizontalAlignment="Center"
                            Margin="16,12,16,8" Padding="18,14" CornerRadius="10" Background="{DynamicResource ChromeBrush}"
                            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7B3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22"
                                       VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                            <StackPanel Margin="14,0,18,0" Width="300">
                                <TextBlock Text="{l:Loc Break_Title}" FontWeight="SemiBold" />
                                <TextBlock x:Name="BreakText" TextWrapping="Wrap" Margin="0,2,0,0" />
                                <ProgressBar x:Name="BreakProgress" Height="3" Maximum="20" Margin="0,8,0,0" />
                            </StackPanel>
                            <Button Content="{l:Loc Break_Dismiss}" VerticalAlignment="Center" Click="OnBreakDismissClick" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Reading settings -->
            <Border x:Name="SettingsPanel" Grid.Column="2" Width="340" Visibility="Collapsed" Margin="0,0,8,0" CornerRadius="8"
                    Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,0,18,24">
                        <TextBlock Text="{l:Loc Settings_Text}" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
                        <TextBlock Text="{l:Loc Settings_Font}" Style="{StaticResource FieldLabel}" Margin="0,4,0,4" />
                        <ComboBox x:Name="FontCombo" HorizontalAlignment="Stretch" MaxDropDownHeight="480"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                  ScrollViewer.CanContentScroll="True" SelectionChanged="OnFontSelectionChanged">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                            <ComboBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Opacity="0.65"
                                                       Margin="10,10,10,4" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ComboBox.GroupStyle>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontFamily="{Binding Family}" FontSize="16" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="{l:Loc Settings_OpenFontsFolder}" Click="OnOpenFontsFolderClick" />
                            <Button Content="{l:Loc Settings_ReloadFonts}" Margin="8,0,0,0" Click="OnReloadFontsClick" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="{l:Loc Settings_FontsHint}" />

                        <DockPanel Margin="0,14,0,0">
                            <TextBlock Text="{l:Loc Settings_Size}" />
                            <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"
                                       Text="{Binding FontSize, Converter={StaticResource Format}, ConverterParameter=Format_Pixels}" />
                        </DockPanel>
                        <Slider Minimum="12" Maximum="40" SmallChange="1" LargeChange="2" Value="{Binding FontSize}" />

                        <DockPanel Margin="0,8,0,0">
                            <TextBlock Text="{l:Loc Settings_LineSpacing}" />
                            <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"
                                       Text="{Binding LineSpacing, Converter={StaticResource Format}, ConverterParameter=Format_Ratio}" />
                        </DockPanel>
                        <Slider Minimum="1.1" Maximum="2.4" SmallChange="0.05" LargeChange="0.1" Value="{Binding LineSpacing}" />

                        <DockPanel Margin="0,8,0,0">
                            <TextBlock Text="{l:Loc Settings_PageWidth}" />
                            <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"
                                       Text="{Binding PageWidth, Converter={StaticResource Format}, ConverterParameter=Format_Em}" />
                        </DockPanel>
                        <Slider Minimum="22" Maximum="60" SmallChange="1" LargeChange="2" Value="{Binding PageWidth}" />

                        <TextBlock Text="{l:Loc Settings_Layout}" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:Loc Settings_View}" Margin="0,0,0,4" />
                                <ComboBox HorizontalAlignment="Stretch" SelectedValuePath="Tag" SelectedValue="{Binding ViewMode}">
                                    <ComboBoxItem Content="{l:Loc Settings_View_Pages}" Tag="{x:Static s:ViewMode.Paged}" />
                                    <ComboBoxItem Content="{l:Loc Settings_View_Scrolling}" Tag="{x:Static s:ViewMode.Scroll}" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{l:Loc Settings_Columns}" Margin="0,0,0,4" />
                                <ComboBox HorizontalAlignment="Stretch" SelectedValuePath="Tag" SelectedValue="{Binding Columns}">
                                    <ComboBoxItem Content="{l:Loc Settings_Columns_Auto}" Tag="{x:Static s:ColumnMode.Auto}" />
                                    <ComboBoxItem Content="{l:Loc Settings_Columns_One}" Tag="{x:Static s:ColumnMode.One}" />
                                    <ComboBoxItem Content="{l:Loc Settings_Columns_Two}" Tag="{x:Static s:ColumnMode.Two}" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="BookFormatCheck" Content="{l:Loc Settings_BookFormat}" Margin="0,14,0,0"
                                  IsChecked="{Binding BookFormatting}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="{l:Loc Settings_BookFormatHint}" />
                        <CheckBox Content="{l:Loc Settings_Justify}" Margin="0,10,0,0" IsChecked="{Binding Justify}" />
                        <CheckBox Content="{l:Loc Settings_Hyphenate}" IsChecked="{Binding Hyphenate}" />
                        <CheckBox Content="{l:Loc Settings_DropCaps}" IsChecked="{Binding DropCaps}" />

                        <TextBlock Text="{l:Loc Settings_EyeComfort}" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="{l:Loc Settings_EyeComfortMode}" IsChecked="{Binding EyeComfort}" />
                        <StackPanel IsEnabled="{Binding EyeComfort}">
                            <ListBox x:Name="ProfileList" Background="Transparent" BorderThickness="0" Margin="-6,6,-6,0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectedValuePath="Id" SelectedValue="{Binding EyeProfile}"
                                     PreviewMouseWheel="OnNestedListMouseWheel">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="42" Height="42" CornerRadius="6" VerticalAlignment="Top"
                                                    Background="{Binding PageBrush}" BorderThickness="1"
                                                    BorderBrush="{DynamicResource DividerBrush}">
                                                <TextBlock Text="Aa" Foreground="{Binding TextBrush}" FontFamily="Georgia" FontSize="17"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" Opacity="0.7" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <DockPanel Margin="0,12,0,0">
                                <TextBlock Text="{l:Loc Settings_Warmth}" />
                                <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"
                                           Text="{Binding Warmth, Converter={StaticResource Format}, ConverterParameter=Format_Percent}" />
                            </DockPanel>
                            <Slider Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" Value="{Binding Warmth}" />
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="{l:Loc Settings_Dim}" />
                                <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"
                                           Text="{Binding Dim, Converter={StaticResource Format}, ConverterParameter=Format_Percent}" />
                            </DockPanel>
                            <Slider Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" Value="{Binding Dim}" />
                        </StackPanel>

                        <CheckBox Content="{l:Loc Settings_BreakReminders}" Margin="0,12,0,0" IsChecked="{Binding BreakReminders}" />
                        <DockPanel Margin="0,6,0,0" IsEnabled="{Binding BreakReminders}">
                            <TextBlock Text="{l:Loc Settings_BreakEvery}" />
                            <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"
                                       Text="{Binding BreakIntervalMinutes, Converter={StaticResource Format}, ConverterParameter=Format_Minutes}" />
                        </DockPanel>
                        <Slider Minimum="5" Maximum="60" SmallChange="5" LargeChange="5" TickFrequency="5" IsSnapToTickEnabled="True"
                                Value="{Binding BreakIntervalMinutes}" IsEnabled="{Binding BreakReminders}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="{l:Loc Settings_BreakHint}" />

                        <TextBlock Text="{l:Loc Settings_ReadAloud}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{l:Loc Settings_Voice}" Margin="0,0,0,4" />
                        <ComboBox x:Name="VoiceCombo" HorizontalAlignment="Stretch" DisplayMemberPath="Name"
                                  SelectionChanged="OnVoiceSelectionChanged" />
                        <Button Content="{l:Loc Settings_PiperButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnPiperVoicesClick" />
                        <TextBlock Style="{StaticResource Hint}" Text="{l:Loc Settings_PiperHint}" />
                        <DockPanel Margin="0,12,0,0">
                            <TextBlock Text="{l:Loc Settings_Speed}" />
                            <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"
                                       Text="{Binding SpeechRate, Converter={StaticResource Format}, ConverterParameter=Format_Speed}" />
                        </DockPanel>
                        <Slider Minimum="0.5" Maximum="2.5" SmallChange="0.1" LargeChange="0.25" TickFrequency="0.1"
                                IsSnapToTickEnabled="True" Value="{Binding SpeechRate}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{l:Loc Settings_ReadAloudHint}" />

                        <TextBlock Text="{l:Loc Settings_Appearance}" Style="{StaticResource SectionTitle}" />
                        <ComboBox HorizontalAlignment="Stretch" SelectedValuePath="Tag" SelectedValue="{Binding Theme}">
                            <ComboBoxItem Content="{l:Loc Settings_Theme_System}" Tag="{x:Static s:AppTheme.System}" />
                            <ComboBoxItem Content="{l:Loc Settings_Theme_Light}" Tag="{x:Static s:AppTheme.Light}" />
                            <ComboBoxItem Content="{l:Loc Settings_Theme_Dark}" Tag="{x:Static s:AppTheme.Dark}" />
                        </ComboBox>
                        <TextBlock Style="{StaticResource Hint}" Text="{l:Loc Settings_ThemeHint}" />

                        <TextBlock Text="{l:Loc Settings_Language}" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                        <ComboBox x:Name="LanguageCombo" HorizontalAlignment="Stretch" DisplayMemberPath="Name"
                                  SelectionChanged="OnLanguageSelectionChanged" />
                        <TextBlock x:Name="LanguageHint" Style="{StaticResource Hint}" Text="{l:Loc Settings_LanguageHint}"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status -->
        <Grid x:Name="StatusBar" Grid.Row="2" Margin="8,4,8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PreviousChapterButton" Style="{StaticResource IconButton}" Height="28" FontSize="12" Content="&#xE892;"
                    ToolTip="{l:Loc Tip_PreviousChapter}" Click="OnPreviousChapterClick" IsEnabled="False" />
            <TextBlock x:Name="ChapterText" Grid.Column="1" Margin="8,0" VerticalAlignment="Center" FontSize="12"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}" />
            <ProgressBar x:Name="BookProgress" Grid.Column="2" Height="3" Maximum="1" VerticalAlignment="Center"
                         Foreground="{DynamicResource AccentBrush}" />
            <TextBlock x:Name="PageText" Grid.Column="3" Margin="8,0" VerticalAlignment="Center" FontSize="12"
                       HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" />
            <Button x:Name="NextChapterButton" Grid.Column="4" Style="{StaticResource IconButton}" Height="28" FontSize="12"
                    Content="&#xE893;" ToolTip="{l:Loc Tip_NextChapter}" Click="OnNextChapterClick" IsEnabled="False" />
        </Grid>
    </Grid>
</Window>