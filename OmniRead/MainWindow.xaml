<hc:Window x:Class="OmniRead.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:OmniRead.Services"
        xmlns:l="clr-namespace:OmniRead.Localization"
        xmlns:local="clr-namespace:OmniRead"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        NonClientAreaBackground="Transparent" NonClientAreaForeground="{DynamicResource TextBrush}"
        NonClientAreaHeight="46" ShowTitle="False" SystemBackdropType="Mica"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="OmniRead" Icon="Assets/OmniRead.ico"
        Width="1280" Height="860" MinWidth="560" MinHeight="420"
        Background="Transparent"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        AllowDrop="True" UseLayoutRounding="True"
        DragOver="OnDragOver" Drop="OnDrop">
    <Window.Resources>
        <!-- Right-click menu of the reading area. Items tagged "selection" need selected text. -->
        <ContextMenu x:Key="ReaderMenu" Opened="OnReaderMenuOpened">
            <MenuItem Header="{l:Loc Menu_LookUp}" InputGestureText="Ctrl+K" Tag="selection" Click="OnMenuLookUpClick" />
            <MenuItem Header="{l:Loc Notes_Highlight}" InputGestureText="Ctrl+H" Tag="selection" Click="OnHighlightClick" />
            <MenuItem Header="{l:Loc Menu_Copy}" InputGestureText="Ctrl+C" Tag="selection" Click="OnMenuCopyClick" />
            <Separator />
            <MenuItem Header="{l:Loc Notes_AddBookmark}" InputGestureText="Ctrl+D" Click="OnAddBookmarkClick" />
            <MenuItem Header="{l:Loc Menu_ReadFromHere}" Click="OnMenuReadFromHereClick" />
        </ContextMenu>
        <l:FormatConverter x:Key="Format" />
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style x:Key="IconButton" TargetType="ButtonBase">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Back" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,22,0,10" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <!-- The toolbar lives in the title bar. Only the two groups of buttons take clicks; the rest still drags the window. -->
    <hc:Window.NonClientAreaContent>
    <Grid x:Name="Toolbar" Margin="6,0,10,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource IconButton}" Content="&#xE8F1;" ToolTip="{l:Loc Tip_Library}" Click="OnLibraryClick" />
            <Button Style="{StaticResource IconButton}" Content="&#xE8E5;" ToolTip="{l:Loc Tip_Open}" Click="OnOpenClick" />
            <ToggleButton x:Name="TocToggle" Style="{StaticResource IconButton}" Content="&#xE8FD;" ToolTip="{l:Loc Tip_Contents}" Click="OnPanelToggle" />
            <ToggleButton x:Name="NotesToggle" Style="{StaticResource IconButton}" Content="&#xE734;" ToolTip="{l:Loc Tip_Notes}" Click="OnPanelToggle" />
            <ToggleButton x:Name="SearchToggle" Style="{StaticResource IconButton}" Content="&#xE721;" ToolTip="{l:Loc Tip_Search}" Click="OnPanelToggle" />
        </StackPanel>
        <TextBlock x:Name="TitleText" Grid.Column="1" Margin="16,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
            <!-- Shown while a book is being read aloud. -->
            <StackPanel x:Name="ReadControls" Orientation="Horizontal" Visibility="Collapsed">
                <Button Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="{l:Loc Read_Previous}" Click="OnReadPreviousClick" />
                <Button x:Name="ReadPauseButton" Style="{StaticResource IconButton}" Content="&#xE769;" ToolTip="{l:Loc Read_Pause}" Click="OnReadPauseClick" />
                <Button Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="{l:Loc Read_Next}" Click="OnReadNextClick" />
                <ToggleButton x:Name="SleepButton" Style="{StaticResource IconButton}" Content="&#xE708;" ToolTip="{l:Loc Read_Sleep}" Click="OnSleepClick" />
            </StackPanel>
            <ToggleButton x:Name="ReadToggle" Style="{StaticResource IconButton}" Content="&#xE767;" ToolTip="{l:Loc Tip_ReadAloud}" Click="OnReadAloudClick" />
            <ToggleButton Style="{StaticResource IconButton}" Content="&#xE7B3;" IsChecked="{Binding EyeComfort}" ToolTip="{l:Loc Tip_EyeComfort}" />
            <ToggleButton x:Name="SettingsToggle" Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="{l:Loc Tip_Settings}" Click="OnPanelToggle" />
            <Button Style="{StaticResource IconButton}" Content="&#xE740;" ToolTip="{l:Loc Tip_FullScreen}" Click="OnFullScreenClick" />
        </StackPanel>
    </Grid>
    </hc:Window.NonClientAreaContent>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Contents -->
            <Border x:Name="TocPanel" Width="290" Visibility="Collapsed" Margin="8,0,0,0" CornerRadius="8"
                    Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{l:Loc Contents_Title}" Style="{StaticResource SectionTitle}" Margin="16,14,16,8" />
                    <ListBox x:Name="TocList" Background="Transparent" BorderThickness="0" Margin="4,0,4,8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnTocSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" Margin="{Binding Indent}" FontWeight="{Binding Weight}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Bookmarks and highlights -->
            <Border x:Name="NotesPanel" Width="320" Visibility="Collapsed" Margin="8,0,0,0" CornerRadius="8"
                    Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{l:Loc Notes_Title}" Style="{StaticResource SectionTitle}" Margin="16,14,16,8" />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="14,0,14,8">
                        <Button Content="{l:Loc Notes_AddBookmark}" ToolTip="Ctrl+D" Click="OnAddBookmarkClick" />
                        <Button Content="{l:Loc Notes_Highlight}" ToolTip="Ctrl+H" Margin="8,0,0,0" Click="OnHighlightClick" />
                    </StackPanel>
                    <Button x:Name="NotesExportButton" DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="14,0,14,8"
                            Content="{l:Loc Notes_Export}" ToolTip="{l:Loc Notes_ExportTip}" Click="OnExportNotesClick" />
                    <TextBlock x:Name="NotesEmpty" DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="16,0,16,8"
                               Text="{l:Loc Notes_Empty}" />
                    <ListBox x:Name="NotesList" Background="Transparent" BorderThickness="0" Margin="4,0,4,8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                             SelectionChanged="OnNoteSelectionChanged">
                        <!-- Rows fill the panel's width, so notes and the delete button line up. -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,3,10,0" VerticalAlignment="Top"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Where}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                        <TextBox Text="{Binding Note, UpdateSourceTrigger=LostFocus}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                 AcceptsReturn="True" ToolTip="{l:Loc Notes_NoteTip}" LostFocus="OnNoteLostFocus" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11"
                                            Content="&#xE711;" VerticalAlignment="Top" ToolTip="{l:Loc Notes_Delete}"
                                            Click="OnDeleteNoteClick" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Search -->
            <Border x:Name="SearchPanel" Width="320" Visibility="Collapsed" Margin="8,0,0,0" CornerRadius="8"
                    Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{l:Loc Search_Title}" Style="{StaticResource SectionTitle}" Margin="16,14,16,8" />
                    <hc:SearchBar x:Name="SearchBox" DockPanel.Dock="Top" Margin="14,0,14,6" Style="{StaticResource SearchBarExtend}"
                             hc:InfoElement.Placeholder="{l:Loc Search_Title}"
                             TextChanged="OnSearchTextChanged"
                             KeyDown="OnSearchKeyDown" />
                    <TextBlock x:Name="SearchStatus" DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="16,0,16,8"
                               Text="{l:Loc Search_Hint}" />
                    <ListBox x:Name="SearchList" Background="Transparent" BorderThickness="0" Margin="4,0,4,8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                             SelectionChanged="OnSearchSelectionChanged">
                        <!-- Rows fill the panel's width, so notes and the delete button line up. -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Before, Mode=OneWay}" /><Run Text="{Binding Match, Mode=OneWay}" FontWeight="Bold"
                                             Foreground="{DynamicResource AccentBrush}" /><Run Text="{Binding After, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Where}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Page -->
            <Border Grid.Column="1" Margin="14,4,14,4" CornerRadius="8" Background="{DynamicResource PageBrush}"
                    BorderThickness="0" ClipToBounds="True">
                <Grid x:Name="ReaderHost">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- A dashed outline round the page. The web view sits just inside it. -->
                    <Rectangle Grid.RowSpan="2" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5" StrokeDashArray="5 4"
                               RadiusX="8" RadiusY="8" IsHitTestVisible="False" SnapsToDevicePixels="True" />
                    <!-- Library: shown while no book is open -->
                    <Grid x:Name="WelcomePanel" Grid.Row="1" Margin="40,28,40,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <Image DockPanel.Dock="Left" Source="Assets/OmniRead.png" Width="56" Height="56"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox Width="150" SelectedValuePath="Tag" SelectedValue="{Binding LibrarySort}"
                                          ToolTip="{l:Loc Library_SortTip}">
                                    <ComboBoxItem Content="{l:Loc Library_Sort_Recent}" Tag="{x:Static s:LibrarySort.LastRead}" />
                                    <ComboBoxItem Content="{l:Loc Library_Sort_Title}" Tag="{x:Static s:LibrarySort.Title}" />
                                    <ComboBoxItem Content="{l:Loc Library_Sort_Author}" Tag="{x:Static s:LibrarySort.Author}" />
                                </ComboBox>
                                <Button Content="{l:Loc Library_Folders}" Margin="8,0,0,0" Click="OnLibraryFoldersClick" />
                                <Button Content="{l:Loc Welcome_Open}" Style="{StaticResource ButtonPrimary}" Margin="8,0,0,0"
                                        Padding="14,6" Click="OnOpenClick" />
                            </StackPanel>
                            <StackPanel Margin="14,0" VerticalAlignment="Center">
                                <TextBlock Text="OmniRead" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock x:Name="LibraryStatus" Style="{StaticResource Hint}" Margin="0" TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" />
                            </StackPanel>
                        </DockPanel>
                        <!-- Narrowing the shelves: by title or author, by format, and by how far the book has been read. -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,0">
                            <hc:SearchBar x:Name="LibrarySearchBox" Width="280" Style="{StaticResource SearchBarExtend}" hc:InfoElement.Placeholder="{l:Loc Library_SearchHint}"
                                     TextChanged="OnLibraryFilterChanged" />
                            <ComboBox x:Name="LibraryFormatCombo" Width="150" Margin="8,0,0,0" SelectionChanged="OnLibraryFilterChanged" />
                            <ComboBox x:Name="LibraryStateCombo" Width="150" Margin="8,0,0,0" SelectedValuePath="Tag" SelectedIndex="0"
                                      SelectionChanged="OnLibraryFilterChanged">
                                <ComboBoxItem Content="{l:Loc Library_Filter_All}" Tag="{x:Static s:ReadState.Any}" />
                                <ComboBoxItem Content="{l:Loc Library_Filter_Unread}" Tag="{x:Static s:ReadState.Unread}" />
                                <ComboBoxItem Content="{l:Loc Library_Filter_Reading}" Tag="{x:Static s:ReadState.Reading}" />
                                <ComboBoxItem Content="{l:Loc Library_Filter_Finished}" Tag="{x:Static s:ReadState.Finished}" />
                            </ComboBox>
                        </StackPanel>
                        <ListBox x:Name="LibraryList" Grid.Row="2" Margin="-8,10,-8,0" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextBrush}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"
                                 PreviewMouseLeftButtonUp="OnLibraryMouseUp" KeyDown="OnLibraryKeyDown"
                                 AllowDrop="True" DragOver="OnShelfDragOver" DragLeave="OnShelfDragLeave" Drop="OnShelfDrop">
                            <!-- One shelf per folder of books, labelled with the library folder's name and the subfolders under it. -->
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <!-- Shelves the reader made carry a tag, and a right-click menu to rename or delete them.
                                                 Any shelf can be dragged by its heading to another place among the shelves. -->
                                            <StackPanel Orientation="Horizontal" Margin="8,14,8,2" Background="Transparent"
                                                        Cursor="SizeAll" ToolTip="{l:Loc Library_ShelfDragTip}"
                                                        MouseLeftButtonDown="OnShelfMouseDown" MouseMove="OnShelfMouseMove"
                                                        MouseRightButtonUp="OnShelfRightClick">
                                                <TextBlock Text="&#xE8EC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                                             Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"
                                                           Visibility="{Binding Name.IsCollection, Converter={StaticResource Visible}}" />
                                                <TextBlock Text="{Binding Name.Name}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                                <TextBlock Text="{Binding ItemCount}" FontSize="13" Margin="10,0,0,2" VerticalAlignment="Bottom"
                                                           Foreground="{DynamicResource MutedBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="150" Margin="2,6" ToolTip="{Binding Path}">
                                        <StackPanel.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{l:Loc Library_Menu_Open}" Click="OnLibraryMenuOpen" />
                                                <MenuItem Header="{l:Loc Library_Menu_ShowInFolder}" Click="OnLibraryMenuShowInFolder" />
                                                <MenuItem Header="{l:Loc Library_Menu_CopyPath}" Click="OnLibraryMenuCopyPath" />
                                                <Separator />
                                                <!-- Filled when it opens; the empty entry only makes the arrow appear. -->
                                                <MenuItem Header="{l:Loc Library_Menu_Collections}" SubmenuOpened="OnLibraryCollectionsOpened">
                                                    <MenuItem />
                                                </MenuItem>
                                                <MenuItem Header="{l:Loc Library_Menu_Details}" Click="OnLibraryMenuDetails" />
                                                <Separator />
                                                <MenuItem Header="{l:Loc Library_Menu_Forget}" Click="OnLibraryMenuForget" />
                                            </ContextMenu>
                                        </StackPanel.ContextMenu>
                                        <Grid Height="216">
                                            <!-- Stands in for a cover when the book has none. -->
                                            <Border CornerRadius="4" Background="{DynamicResource HoverBrush}"
                                                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" TextAlignment="Center"
                                                           VerticalAlignment="Center" Margin="12" FontFamily="Georgia" FontSize="15"
                                                           MaxHeight="150" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Background="#B0000000"
                                                    CornerRadius="3" Margin="6" Padding="5,1">
                                                <TextBlock Text="{Binding Format}" Foreground="White" FontSize="10" />
                                            </Border>
                                        </Grid>
                                        <ProgressBar Style="{StaticResource ProgressBarFlat}" Height="3" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Margin="0,6,0,0"
                                                     Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <!-- The book itself. A web view is a window of its own: nothing drawn by WPF can sit on top of it,
                         so the break reminder has its own row and the page-turn strips live inside the page. -->
                    <wv2:WebView2 x:Name="Web" Grid.Row="1" Margin="3" Visibility="Collapsed" AllowExternalDrop="True" />

                    <StackPanel x:Name="LoadingText" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <hc:LoadingCircle Width="36" Height="36" />
                        <TextBlock Text="{l:Loc Status_Opening}" FontSize="16" Margin="0,14,0,0" Foreground="{DynamicResource MutedBrush}" />
                    </StackPanel>

                    <!-- Card for footnotes and dictionary definitions; opens at the pointer. -->
                    <Popup x:Name="InfoPopup" Placement="Mouse" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Margin="8" Padding="16,14" CornerRadius="8" MaxWidth="460" Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                TextElement.Foreground="{DynamicResource TextBrush}">
                            <StackPanel>
                                <TextBlock x:Name="InfoTitle" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                                    <TextBlock x:Name="InfoBody" TextWrapping="Wrap" LineHeight="21" />
                                </ScrollViewer>
                                <TextBlock x:Name="InfoFooter" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                                <Button x:Name="InfoAction" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnInfoActionClick" />
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- 20-20-20 break reminder -->
                    <Border x:Name="BreakBanner" Visibility="Collapsed" HorizontalAlignment="Center" Margin="16,12,16,8" Padding="18,14"
                            CornerRadius="10" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7B3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22"
                                       VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                            <StackPanel Margin="14,0,18,0" Width="300">
                                <TextBlock Text="{l:Loc Break_Title}" FontWeight="SemiBold" />
                                <TextBlock x:Name="BreakText" TextWrapping="Wrap" Margin="0,2,0,0" />
                                <ProgressBar Style="{StaticResource ProgressBarFlat}" x:Name="BreakProgress" Height="3" Maximum="20" Margin="0,8,0,0" />
                            </StackPanel>
                            <Button Content="{l:Loc Break_Dismiss}" VerticalAlignment="Center" Click="OnBreakDismissClick" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Reading settings -->
            <Border x:Name="SettingsPanel" Grid.Column="2" Width="480" Visibility="Collapsed" Margin="0,0,8,0" CornerRadius="8"
                    Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                <DockPanel>
                    <!-- Things that are done rather than set have no place in a property grid; they sit beneath it. -->
                    <WrapPanel DockPanel.Dock="Bottom" Margin="10,6,10,12">
                        <WrapPanel.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Margin" Value="4" />
                            </Style>
                        </WrapPanel.Resources>
                        <Button Content="{l:Loc Settings_OpenFontsFolder}" Click="OnOpenFontsFolderClick" />
                        <Button Content="{l:Loc Settings_ReloadFonts}" Click="OnReloadFontsClick" />
                        <Button Content="{l:Loc Settings_History}" Click="OnHistoryClick" />
                        <Button Content="{l:Loc Settings_PiperButton}" Click="OnPiperVoicesClick" />
                        <Button Content="{l:Loc Settings_Audiobook}" Click="OnAudiobookClick" />
                        <Button Content="{l:Loc Backup_Create}" Click="OnBackupClick" />
                        <Button Content="{l:Loc Backup_Restore}" Click="OnRestoreClick" />
                    </WrapPanel>
                    <local:SettingsGrid x:Name="SettingsGrid" Style="{StaticResource {x:Type hc:PropertyGrid}}" Margin="6,6,6,0" MinTitleWidth="205" MaxTitleWidth="240" ShowSortButton="False"
                                        Background="Transparent" BorderThickness="0" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- Status -->
        <Grid x:Name="StatusBar" Grid.Row="2" Margin="8,4,8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PreviousChapterButton" Style="{StaticResource IconButton}" Height="28" FontSize="12" Content="&#xE892;"
                    ToolTip="{l:Loc Tip_PreviousChapter}" Click="OnPreviousChapterClick" IsEnabled="False" />
            <TextBlock x:Name="ChapterText" Grid.Column="1" Margin="8,0" VerticalAlignment="Center" FontSize="12"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}" />
            <ProgressBar Style="{StaticResource ProgressBarFlat}" x:Name="BookProgress" Grid.Column="2" Height="3" Maximum="1" VerticalAlignment="Center"
                         Foreground="{DynamicResource AccentBrush}" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,0">
                <!-- The page being read; typing a number and pressing Enter goes to that page. -->
                <StackPanel x:Name="PagePanel" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding HasPages, Converter={StaticResource Boolean2VisibilityConverter}}">
                    <TextBlock Text="{l:Loc Status_PageLabel}" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource MutedBrush}" />
                    <TextBox x:Name="PageBox" Text="{Binding CurrentPage, Mode=OneWay}" MinWidth="44" MinHeight="0" Height="24"
                             Padding="4,0" Margin="6,0" FontSize="12" TextAlignment="Center" VerticalContentAlignment="Center"
                             MaxLength="6" ToolTip="{l:Loc Tip_GoToPage}" KeyDown="OnPageBoxKeyDown" LostFocus="OnPageBoxLostFocus" />
                    <TextBlock Text="{Binding TotalText}" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock Text="  ·  " VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>
                <TextBlock x:Name="PageText" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
            <Button x:Name="NextChapterButton" Grid.Column="4" Style="{StaticResource IconButton}" Height="28" FontSize="12"
                    Content="&#xE893;" ToolTip="{l:Loc Tip_NextChapter}" Click="OnNextChapterClick" IsEnabled="False" />
        </Grid>
    </Grid>
</hc:Window>