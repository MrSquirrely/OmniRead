<Application x:Class="OmniRead.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- HandyControls: its light and dark colours, and its styles for the stock and added controls. -->
                <hc:ThemeResources />
                <hc:Theme />
            </ResourceDictionary.MergedDictionaries>

            <!-- Placeholders; ThemeManager replaces these at startup and whenever the theme or eye profile changes. -->
            <SolidColorBrush x:Key="PageBrush" Color="#FDFDFC" />
            <SolidColorBrush x:Key="ChromeBrush" Color="#F1F1F0" />
            <SolidColorBrush x:Key="PanelBrush" Color="#F8F8F7" />
            <SolidColorBrush x:Key="TextBrush" Color="#1C1C1C" />
            <SolidColorBrush x:Key="MutedBrush" Color="#7A7A7A" />
            <SolidColorBrush x:Key="DividerBrush" Color="#D9D9D9" />
            <SolidColorBrush x:Key="HoverBrush" Color="#E2E2E2" />
            <SolidColorBrush x:Key="CodeBrush" Color="#EDEDED" />
            <SolidColorBrush x:Key="AccentBrush" Color="#005FB8" />
            <SolidColorBrush x:Key="TitleBarBrush" Color="#E6E6E4" />

            <!-- Rows of two drop-downs in the settings grid. -->
            <DataTemplate x:Key="FontItemTemplate">
                <TextBlock Text="{Binding Name}" FontFamily="{Binding Family}" FontSize="16" />
            </DataTemplate>
            <DataTemplate x:Key="ProfileItemTemplate">
                <StackPanel Orientation="Horizontal">
                    <Border Width="26" Height="22" CornerRadius="4" Background="{Binding PageBrush}" BorderThickness="1"
                            BorderBrush="{DynamicResource DividerBrush}">
                        <TextBlock Text="Aa" Foreground="{Binding TextBrush}" FontFamily="Georgia" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding Name}" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="{Binding Description}" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>