<Application x:Class="OmniRead.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Placeholders; ThemeManager replaces these at startup and whenever the theme or eye profile changes. -->
        <SolidColorBrush x:Key="PageBrush" Color="#FDFDFC" />
        <SolidColorBrush x:Key="ChromeBrush" Color="#F1F1F0" />
        <SolidColorBrush x:Key="PanelBrush" Color="#F8F8F7" />
        <SolidColorBrush x:Key="TextBrush" Color="#1C1C1C" />
        <SolidColorBrush x:Key="MutedBrush" Color="#7A7A7A" />
        <SolidColorBrush x:Key="DividerBrush" Color="#D9D9D9" />
        <SolidColorBrush x:Key="HoverBrush" Color="#E2E2E2" />
        <SolidColorBrush x:Key="CodeBrush" Color="#EDEDED" />
        <SolidColorBrush x:Key="AccentBrush" Color="#005FB8" />
    </Application.Resources>
</Application>