<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Product>OmniRead</Product>
    <Version>1.1.0</Version>
    <ApplicationIcon>Assets\OmniRead.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>OmniRead.Program</StartupObject>
    <NoWarn>$(NoWarn)</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <Content Include="Fonts\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- The offline dictionary, built from WordNet by tools\BuildDictionary.cs. -->
    <Content Include="Data\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\OmniRead.ico" />
    <Resource Include="Assets\OmniRead.png" />
    <!-- The page shown in the web view: structural styles and the script that paginates a chapter. -->
    <EmbeddedResource Include="Rendering\Reader.html" LogicalName="OmniRead.Rendering.Reader.html" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.10.5" />
    <PackageReference Include="AngleSharp.Css" Version="1.5.0" />
    <PackageReference Include="HandyControls" Version="3.7.0" />
    <PackageReference Include="Markdig" Version="1.6.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
    <PackageReference Include="VersOne.Epub" Version="3.3.6" />
  </ItemGroup>

</Project>