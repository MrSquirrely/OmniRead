<hc:Window x:Class="OmniRead.AudiobookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:OmniRead.Localization"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        NonClientAreaBackground="{DynamicResource TitleBarBrush}" NonClientAreaForeground="{DynamicResource TextBrush}"
        Title="{l:Loc Audiobook_Title}" Icon="Assets/OmniRead.ico"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14">
    <StackPanel Margin="20">
        <TextBlock x:Name="BookText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="VoiceText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />

        <StackPanel x:Name="Choices">
            <TextBlock Text="{l:Loc Audiobook_What}" Margin="0,16,0,6" />
            <RadioButton x:Name="ChapterChoice" GroupName="What" IsChecked="True" HorizontalAlignment="Left" />
            <RadioButton x:Name="BookChoice" GroupName="What" HorizontalAlignment="Left" Margin="0,6,0,0" />

            <TextBlock Text="{l:Loc Audiobook_Format}" Margin="0,14,0,6" />
            <RadioButton x:Name="EncodedChoice" GroupName="Format" Content="{l:Loc Audiobook_FormatM4a}" IsChecked="True" HorizontalAlignment="Left" />
            <RadioButton GroupName="Format" Content="{l:Loc Audiobook_FormatWave}" HorizontalAlignment="Left" Margin="0,6,0,0" />

            <TextBlock Text="{l:Loc Audiobook_Folder}" Margin="0,14,0,4" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{l:Loc Audiobook_Browse}" Margin="8,0,0,0" Click="OnBrowseClick" />
                <TextBox x:Name="FolderBox" />
            </DockPanel>
            <TextBlock Text="{l:Loc Audiobook_FolderHint}" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedBrush}" />
        </StackPanel>

        <ProgressBar Style="{StaticResource ProgressBarFlat}" x:Name="Progress" Height="4" Maximum="1" Margin="0,18,0,0" Foreground="{DynamicResource AccentBrush}" />
        <TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap" MinHeight="40" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="StartButton" Content="{l:Loc Audiobook_Start}" IsDefault="True" MinWidth="88" Click="OnStartClick" />
            <Button x:Name="CloseButton" Content="{l:Loc Piper_Close}" MinWidth="88" Margin="8,0,0,0" Click="OnCloseClick" />
        </StackPanel>
    </StackPanel>
</hc:Window>