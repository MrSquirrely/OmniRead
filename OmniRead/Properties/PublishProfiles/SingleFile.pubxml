<?xml version="1.0" encoding="utf-8"?>
<!--
  One self-contained OmniRead.exe for 64-bit Windows 11; nothing else has to be installed (the WebView2 runtime it
  draws pages with is part of Windows 11).

      dotnet publish OmniRead -p:PublishProfile=SingleFile

  The fonts, the dictionary and the hyphenation patterns are packed into the exe too. They, and the .NET runtime, are unpacked to a
  folder under %TEMP%\.net the first time the exe runs, which makes that first start a few seconds slower.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Fonts, the dictionary and the hyphenation patterns are opened as files, so everything is unpacked to disk rather than run from memory. -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <NoWarn>$(NoWarn);NETSDK1244</NoWarn>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>..\release\</PublishDir>
  </PropertyGroup>
</Project>