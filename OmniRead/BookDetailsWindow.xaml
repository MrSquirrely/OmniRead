<hc:Window x:Class="OmniRead.BookDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:OmniRead.Localization"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        NonClientAreaBackground="{DynamicResource TitleBarBrush}" NonClientAreaForeground="{DynamicResource TextBrush}"
        Title="{l:Loc Details_Title}" Icon="Assets/OmniRead.ico"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cover -->
        <StackPanel Width="150">
            <Grid Height="216">
                <Border CornerRadius="4" Background="{DynamicResource HoverBrush}" BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1">
                    <TextBlock Text="{l:Loc Details_NoCover}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                               Margin="12" Foreground="{DynamicResource MutedBrush}" />
                </Border>
                <Image x:Name="CoverImage" Stretch="UniformToFill" />
            </Grid>
            <Button Content="{l:Loc Details_ChooseCover}" HorizontalAlignment="Stretch" Margin="0,10,0,0" Click="OnChooseCoverClick" />
            <Button x:Name="OwnCoverButton" Content="{l:Loc Details_OwnCover}" HorizontalAlignment="Stretch" Margin="0,6,0,0"
                    Click="OnOwnCoverClick" />
        </StackPanel>

        <!-- Text -->
        <StackPanel Grid.Column="1" Margin="20,0,0,0">
            <TextBlock Text="{l:Loc Details_BookTitle}" Margin="0,0,0,4" />
            <TextBox x:Name="TitleBox" />
            <TextBlock Text="{l:Loc Details_Author}" Margin="0,14,0,4" />
            <TextBox x:Name="AuthorBox" />
            <TextBlock Text="{l:Loc Details_Series}" Margin="0,14,0,4" />
            <TextBox x:Name="SeriesBox" Width="90" HorizontalAlignment="Left" ToolTip="{l:Loc Details_SeriesHint}" />
            <TextBlock x:Name="PathText" Margin="0,14,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedBrush}" />
            <TextBlock Text="{l:Loc Details_Hint}" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedBrush}" />
        </StackPanel>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,20,0,0">
            <Button DockPanel.Dock="Left" Content="{l:Loc Details_Reset}" Click="OnResetClick" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{l:Loc Dialog_OK}" IsDefault="True" MinWidth="88" Click="OnAcceptClick" />
                <Button Content="{l:Loc Dialog_Cancel}" IsCancel="True" MinWidth="88" Margin="8,0,0,0" />
            </StackPanel>
        </DockPanel>
    </Grid>
</hc:Window>